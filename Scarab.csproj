<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Scarab</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Scarab.Tests\**" />
    <Content Remove="Scarab.Tests\**" />
    <None Remove="Scarab.Tests\**" />
    <Compile Remove="Scarab.AppHost\**" />
    <Content Remove="Scarab.AppHost\**" />
    <None Remove="Scarab.AppHost\**" />
    <Compile Remove="Scarab.ServiceDefaults\**" />
    <Content Remove="Scarab.ServiceDefaults\**" />
    <None Remove="Scarab.ServiceDefaults\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.3" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Scarab.ServiceDefaults\Scarab.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
